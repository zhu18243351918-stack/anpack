{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Anpack desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default", "dialog:default", "deep-link:default", "fs:default", "opener:default", "stronghold:default", "updater:default",
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$APPCACHE/**" }, { "path": "$APPDATA/**" }, { "path": "$HOME/**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$APPCACHE/**" }, { "path": "$APPDATA/**" }] }
  ]
}
